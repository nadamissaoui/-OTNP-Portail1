# Configuration OpenAI pour le Chatbot IA
# Copiez ce fichier en .env et ajoutez votre clé API OpenAI

REACT_APP_OPENAI_API_KEY=sk-votre-cle-api-ici

# API d'analyse de logs backend
REACT_APP_LOGS_API_URL=http://localhost:8089/api/logs
REACT_APP_LOG_ANALYSIS_API_URL=http://localhost:8089/api/log-analysis

# Pour obtenir une clé API:
# 1. Allez sur https://platform.openai.com/api-keys
# 2. Créez un compte ou connectez-vous
# 3. Cliquez sur "Create new secret key"
# 4. Copiez la clé et collez-la ici
